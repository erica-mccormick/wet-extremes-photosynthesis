# Function to subtract date ranges
def subtract_date_ranges(df_main, df_remove):
    new_ranges = []

    for (main_start, main_end) in df_main.itertuples(index=False):
        temp_ranges = [(main_start, main_end)]

        for (remove_start, remove_end) in df_remove.itertuples(index=False):
            updated_temp = []
            for start, end in temp_ranges:
                # No overlap
                if end < remove_start or start > remove_end:
                    updated_temp.append((start, end))
                else:
                    # Leftover part before removal range
                    if start < remove_start:
                        updated_temp.append((start, remove_start - pd.Timedelta(days=1)))
                    # Leftover part after removal range
                    if end > remove_end:
                        updated_temp.append((remove_end + pd.Timedelta(days=1), end))

            temp_ranges = updated_temp  # Update for next iteration
        
        new_ranges.extend(temp_ranges)  # Collect final results

    return pd.DataFrame(new_ranges, columns=['start', 'end'])


