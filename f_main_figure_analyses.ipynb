event['storm_ongoing'] = event['storm_length_so_far'] <= event['storm_length']

# Calculate storm amount so far
site_name, day, total_p = [], [], []
for site in event.SITE_ID.unique():
    # Get event data for a single site
    temp = event[event['SITE_ID'] == site]
    temp['storm_start'] = pd.to_datetime(temp['storm_start'])
    # Get the total data for the site
    dd_data = load_data(site)
    # Iterate through each storm
    for idx, row in temp.iterrows():
        storm_start_day = row['storm_start']
        dd_storm = dd_data[dd_data['TIMESTAMP'] >= storm_start_day]
        dd_storm = dd_storm[dd_storm['TIMESTAMP'] <= row['day']]
        total_p.append(dd_storm['P_F'].sum())
        swc_day = storm_start_day - timedelta(days=2) # THIS WAS 5 IN SUBMISSION 1, LETS MAKE IT 2 INSTEAD!!
        site_name.append(site)
        day.append(row['day'])
        
storm_amount_so_far = pd.DataFrame({'SITE_ID':site_name, 'day':day, 'storm_amount_so_far':total_p})

